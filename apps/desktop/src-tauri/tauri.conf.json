{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BTT Writer",
  "version": "3.0.6",
  "identifier": "org.solucionestechn.bttwriter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BTT Writer",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'sha256-78Em7iFP0j/+Xl+CFzi5y+eJuo8YP7TA3AzmC93QjDA='; img-src 'self' asset: http://asset.localhost https: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost 'self'; frame-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "targets": "all",
    "publisher": "Solucionestechn",
    "category": "Education",
    "shortDescription": "BTT Writer: herramienta de traducción bíblica",
    "longDescription": "Reescritura en Rust de BTT Writer (Bible Translation Tools) con interfaz Tauri para Windows, macOS, Linux, Android e iOS.",
    "resources": [
      "resources/index.sqlite",
      "resources/containers.zip"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/joseeliezerr7/btt-writer-rs/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdERTIzRDQzMDk5RjA1NEUKUldST0JaOEpRejNpZlN4aFRoZXVIOS9lZ2F2bWhCQmRucmZicEllQ2JQeUVXM3I5QVVDZWkzL1IK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
